# ─── Supabase (create fresh project at supabase.com) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server writes (brand save, creatives) need the secret/service role key from
# Supabase → Project Settings → API. Must match the same project as the URL above.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── AI — Anthropic (Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Image Generation — fal (preferred) ─────────────────────────────────────────
# Cascade: Nano Banana 2 @ 1K → Ideogram v3 → FLUX.2 Pro
FAL_KEY=

# ─── Image Generation — Replicate (optional fallback) ───────────────────────────
REPLICATE_API_TOKEN=r8_...

# ─── App URL (update after Vercel deploy) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mount path when served under inventious.co (Promo OS rewrites /admode here)
NEXT_PUBLIC_BASE_PATH=/admode

# ─── Meta Ad Library (market reference on brief step) ───────────────────────────
META_ACCESS_TOKEN=

# ─── Visual research (silent agency moodboard before image gen) ─────────────────
# On by default. Set to false to disable all external research.
# VISUAL_RESEARCH_ENABLED=true
#
# Priority: user → Pinterest → Bing → Dribbble → Unsplash → Are.na → Openverse → pack
#
# Pinterest (restricted pin_search beta — may 401 until approved):
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_COUNTRY_CODE=IN
# PINTEREST_LOCALE=en-IN
#
# Bing Image Search v7 (Azure) — best ad-photo discovery while Pinterest blocked:
# BING_SEARCH_API_KEY=
#
# Unsplash — mood / photography refs (free app key):
# UNSPLASH_ACCESS_KEY=
#
# Optional:
# ARENA_ACCESS_TOKEN=
# DRIBBBLE_ACCESS_TOKEN=


# ─── Optional: auto-run schema migrations via POST /api/admin/migrate-schema ───
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
