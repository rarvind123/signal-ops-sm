{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "inventious.co" }],
      "destination": "https://promo-os-inventious.vercel.app/"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.inventious.co" }],
      "destination": "https://promo-os-inventious.vercel.app/"
    },
    {
      "source": "/:path((?!admode).*)",
      "has": [{ "type": "host", "value": "inventious.co" }],
      "destination": "https://promo-os-inventious.vercel.app/:path*"
    },
    {
      "source": "/:path((?!admode).*)",
      "has": [{ "type": "host", "value": "www.inventious.co" }],
      "destination": "https://promo-os-inventious.vercel.app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/admode",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode",
      "permanent": true
    },
    {
      "source": "/admode/:path*",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode/:path*",
      "permanent": true
    }
  ]
}
