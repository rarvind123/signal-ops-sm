{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "inventious.co" }],
      "destination": "/promo-os-landing.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.inventious.co" }],
      "destination": "/promo-os-landing.html"
    },
    {
      "source": "/:path((?!admode|promo-os-landing.html).*)",
      "has": [{ "type": "host", "value": "inventious.co" }],
      "destination": "/promo-os-landing.html"
    },
    {
      "source": "/:path((?!admode|promo-os-landing.html).*)",
      "has": [{ "type": "host", "value": "www.inventious.co" }],
      "destination": "/promo-os-landing.html"
    }
  ],
  "redirects": [
    {
      "source": "/admode",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode",
      "permanent": true
    },
    {
      "source": "/admode/:path*",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "signal-ops-sm.vercel.app" }],
      "destination": "https://inventious.co/admode/:path*",
      "permanent": true
    }
  ]
}
